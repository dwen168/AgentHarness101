    <diagram id="HarnessArchitecture" name="AI Coding Harness Architecture &amp; Lifecycle">
        <mxGraphModel dx="1032" dy="383" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
