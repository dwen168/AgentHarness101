                <mxCell id="title" value="&lt;b&gt;AI CODING HARNESS: ARCHITECTURE &amp;amp; LIFECYCLE (LAB 2)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; color: #555555;&quot;&gt;From Prompt-Only to a Resilient, Observable, and Controlled Engineering Workflow&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#d0d7de;strokeWidth=1;fontSize=18;fontColor=#24292f;align=center;arcSize=8;" parent="1" vertex="1">
