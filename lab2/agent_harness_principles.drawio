<mxfile host="app.diagrams.net" modified="2026-11-15T10:07:00.000Z" agent="Antigravity" version="24.0.0">
  <diagram id="HarnessPrinciples" name="Agent Harness Principles &amp; Lab 2 Mapping">
    <mxGraphModel dx="1420" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE BANNER ==================== -->
        <mxCell id="title" value="&lt;b&gt;PRINCIPLES OF AGENT HARNESS CODING &amp;amp; LAB 2 MAPPING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; color: #555555;&quot;&gt;How Harness Engineering transforms probabilistic AI models into deterministic, safe software engineering systems&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#d0d7de;strokeWidth=1;fontSize=18;fontColor=#24292f;align=center;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="55" as="geometry" />
        </mxCell>


        <!-- ==================== SECTION 1: THE CORE PARADIGM ==================== -->
        <mxCell id="sec1_container" value="&lt;b&gt;SECTION 1: THE FUNDAMENTAL PARADIGM SHIFT&lt;/b&gt; — Why AI Models Need a Harness Outer Shell" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;strokeWidth=2;fontSize=13;fontColor=#33691e;arcSize=6;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1320" height="230" as="geometry" />
        </mxCell>

        <!-- Box A: The Naked LLM -->
        <mxCell id="box_naked_llm" value="&lt;b style=&quot;font-size: 14px; color: #c62828;&quot;&gt;The Naked AI Model / Prompt-Only&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #555;&quot;&gt;(Probabilistic &amp;amp; Unconstrained)&lt;/span&gt;&lt;br/&gt;&lt;hr style=&quot;border: 0.5px solid #ef9a9a;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #333;&quot;&gt;• &lt;b&gt;Hallucinations:&lt;/b&gt; Invents non-existent APIs &amp;amp; files&lt;br/&gt;• &lt;b&gt;No Grounding:&lt;/b&gt; Blind to repository structure &amp;amp; runtime&lt;br/&gt;• &lt;b&gt;Unsafe Execution:&lt;/b&gt; May run destructive &lt;code&gt;rm -rf&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Self-Delusion:&lt;/b&gt; Claims &quot;I fixed it&quot; without running tests&lt;br/&gt;• &lt;b&gt;Unbounded Scope:&lt;/b&gt; Rewrites unrelated production files&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;strokeWidth=1.5;fontSize=12;fontColor=#b71c1c;arcSize=8;align=center;" vertex="1" parent="sec1_container">
          <mxGeometry x="25" y="40" width="330" height="170" as="geometry" />
        </mxCell>

        <!-- Box B: The Harness Layer -->
        <mxCell id="box_harness_layer" value="&lt;b style=&quot;font-size: 14px; color: #01579b;&quot;&gt;THE HARNESS (The Outer Shell)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #0277bd;&quot;&gt;Deterministic Operating System for Coding Agents&lt;/span&gt;&lt;br/&gt;&lt;hr style=&quot;border: 0.5px solid #81d4fa;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #01579b;&quot;&gt;1. &lt;b&gt;Context Curating:&lt;/b&gt; Scans repo, prunes noise, limits tokens&lt;br/&gt;2. &lt;b&gt;Security Sandbox:&lt;/b&gt; Enforces directory &amp;amp; command boundaries&lt;br/&gt;3. &lt;b&gt;Planning &amp;amp; Gates:&lt;/b&gt; Forces explicit plans &amp;amp; human approval&lt;br/&gt;4. &lt;b&gt;Objective Verifier:&lt;/b&gt; Runs test suites &amp;amp; code guards&lt;br/&gt;5. &lt;b&gt;Self-Healing Loop:&lt;/b&gt; Feeds test tracebacks back into agent&lt;br/&gt;6. &lt;b&gt;Audit Stream:&lt;/b&gt; Structured logging for every single action&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=2;fontSize=12;fontColor=#01579b;arcSize=8;align=center;" vertex="1" parent="sec1_container">
          <mxGeometry x="450" y="35" width="420" height="180" as="geometry" />
        </mxCell>

        <!-- Box C: Production Engineering -->
        <mxCell id="box_prod_eng" value="&lt;b style=&quot;font-size: 14px; color: #1b5e20;&quot;&gt;Reliable Software Engineering&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #2e7d32;&quot;&gt;(Deterministic &amp;amp; Enterprise-Ready)&lt;/span&gt;&lt;br/&gt;&lt;hr style=&quot;border: 0.5px solid #a5d6a7;&quot;/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: #1b5e20;&quot;&gt;• &lt;b&gt;Guaranteed Quality:&lt;/b&gt; Passes 100% of test suites&lt;br/&gt;• &lt;b&gt;Minimal Blast Radius:&lt;/b&gt; Only target files touched&lt;br/&gt;• &lt;b&gt;Zero Unauthorized Escapes:&lt;/b&gt; Hard boundary isolation&lt;br/&gt;• &lt;b&gt;Predictable Cost:&lt;/b&gt; Bounded retries prevent token loops&lt;br/&gt;• &lt;b&gt;Compliance &amp;amp; Audit:&lt;/b&gt; Full forensic replay trace&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=12;fontColor=#1b5e20;arcSize=8;align=center;" vertex="1" parent="sec1_container">
          <mxGeometry x="965" y="40" width="330" height="170" as="geometry" />
        </mxCell>

        <!-- Arrows in Section 1 -->
        <mxCell id="s1_arrow1" value="Tamed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0288d1;strokeWidth=2;fontColor=#01579b;fontSize=11;" edge="1" source="box_naked_llm" target="box_harness_layer" parent="sec1_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1_arrow2" value="Delivers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;fontSize=11;" edge="1" source="box_harness_layer" target="box_prod_eng" parent="sec1_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ==================== SECTION 2: 6 CORE PRINCIPLES & LAB 2 MAPPING ==================== -->
        <mxCell id="sec2_container" value="&lt;b&gt;SECTION 2: THE 6 CORE PRINCIPLES &amp;amp; HOW THEY MAP TO OUR LAB 2 SIMULATION&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;strokeWidth=2;fontSize=13;fontColor=#263238;arcSize=6;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="1320" height="625" as="geometry" />
        </mxCell>

        <!-- CARD 1: Context Engineering -->
        <mxCell id="card1" value="&lt;b style=&quot;font-size: 13px; color: #0d47a1;&quot;&gt;Principle 1: Context Engineering &amp;amp; Grounding&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; margin-top: 6px; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color: #555;&quot;&gt;THEORY:&lt;/b&gt; LLMs cannot see your drive. The harness must discover, filter, and inject precise repository ground-truth without exceeding context windows or leaking binary junk.&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #0288d1;&quot;&gt;OUR LAB 2 IMPLEMENTATION:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;background: #e3f2fd; color: #01579b;&quot;&gt;harness/context.py&lt;/code&gt; &amp;rarr; &lt;b&gt;collect_repository_context()&lt;/b&gt;&lt;br/&gt;• Filters &lt;code&gt;ALLOWED_EXTENSIONS&lt;/code&gt; (&lt;code&gt;.py&lt;/code&gt;, &lt;code&gt;.md&lt;/code&gt;, &lt;code&gt;.json&lt;/code&gt;)&lt;br/&gt;• Automatically prunes &lt;code&gt;.venv&lt;/code&gt; &amp;amp; &lt;code&gt;__pycache__&lt;/code&gt;&lt;br/&gt;• Imposes strict character budget limit (&lt;b&gt;12,000 chars&lt;/b&gt;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90caf9;strokeWidth=1.5;arcSize=8;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="sec2_container">
          <mxGeometry x="25" y="45" width="405" height="175" as="geometry" />
        </mxCell>

        <!-- CARD 2: Security & Boundary Isolation -->
        <mxCell id="card2" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;Principle 2: Boundary Guards &amp;amp; Least Privilege&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; margin-top: 6px; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color: #555;&quot;&gt;THEORY:&lt;/b&gt; Autonomous agents will blindly execute shell commands or traverse directories unless constrained by absolute sandboxing and privilege guardrails.&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #f57c00;&quot;&gt;OUR LAB 2 IMPLEMENTATION:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;background: #fff3e0; color: #e65100;&quot;&gt;harness/context.py&lt;/code&gt; &amp;rarr; &lt;b&gt;is_path_inside_repository()&lt;/b&gt;&lt;br/&gt;• Blocks directory traversal escapes (e.g. &lt;code&gt;../outside.txt&lt;/code&gt; &amp;rarr; &lt;b&gt;False&lt;/b&gt;)&lt;br/&gt;&lt;code style=&quot;background: #fff3e0; color: #e65100;&quot;&gt;harness/executor.py&lt;/code&gt; &amp;rarr; &lt;b&gt;is_command_safe()&lt;/b&gt;&lt;br/&gt;• Intercepts &amp;amp; kills blocked patterns (&lt;code&gt;rm -rf&lt;/code&gt;, &lt;code&gt;format&lt;/code&gt;, &lt;code&gt;shutdown&lt;/code&gt;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffcc80;strokeWidth=1.5;arcSize=8;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="sec2_container">
          <mxGeometry x="455" y="45" width="410" height="175" as="geometry" />
        </mxCell>

        <!-- CARD 3: Planning & Human-in-the-Loop -->
        <mxCell id="card3" value="&lt;b style=&quot;font-size: 13px; color: #4a148c;&quot;&gt;Principle 3: Structured Plan &amp;amp; Human Gatekeeper&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; margin-top: 6px; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color: #555;&quot;&gt;THEORY:&lt;/b&gt; Separate the decision of WHAT to do from the execution of DOING it. High-stakes actions require human approval before code mutation occurs.&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #7b1fa2;&quot;&gt;OUR LAB 2 IMPLEMENTATION:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;background: #f3e5f5; color: #4a148c;&quot;&gt;harness/planner.py&lt;/code&gt; &amp;rarr; &lt;b&gt;create_plan()&lt;/b&gt;&lt;br/&gt;• Produces deterministic dataclass: objective, files, expected changes&lt;br/&gt;&lt;code style=&quot;background: #f3e5f5; color: #4a148c;&quot;&gt;harness/orchestrator.py&lt;/code&gt; &amp;rarr; &lt;b&gt;request_human_approval()&lt;/b&gt;&lt;br/&gt;• Pauses for user &lt;code&gt;yes/no&lt;/code&gt; before any agent touches disk&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ce93d8;strokeWidth=1.5;arcSize=8;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="sec2_container">
          <mxGeometry x="890" y="45" width="405" height="175" as="geometry" />
        </mxCell>

        <!-- CARD 4: Agent Abstraction & Tooling -->
        <mxCell id="card4" value="&lt;b style=&quot;font-size: 13px; color: #1b5e20;&quot;&gt;Principle 4: Agent Abstraction Layer&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; margin-top: 6px; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color: #555;&quot;&gt;THEORY:&lt;/b&gt; Never hardcode your system to a single model provider. The harness should treat the agent as a pluggable backend interface with timeout controls.&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #2e7d32;&quot;&gt;OUR LAB 2 IMPLEMENTATION:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;background: #e8f5e9; color: #1b5e20;&quot;&gt;harness/executor.py&lt;/code&gt; &amp;rarr; &lt;b&gt;execute_agent()&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Simulated Mode:&lt;/b&gt; In-memory deterministic patch for offline zero-cost labs&lt;br/&gt;• &lt;b&gt;External CLI Mode:&lt;/b&gt; Dispatches seamlessly to &lt;code&gt;claude&lt;/code&gt;, &lt;code&gt;codex&lt;/code&gt;, or &lt;code&gt;gemini&lt;/code&gt; via unified subprocess with 120s timeout&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5d6a7;strokeWidth=1.5;arcSize=8;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="sec2_container">
          <mxGeometry x="25" y="240" width="405" height="175" as="geometry" />
        </mxCell>

        <!-- CARD 5: Objective Verification -->
        <mxCell id="card5" value="&lt;b style=&quot;font-size: 13px; color: #b71c1c;&quot;&gt;Principle 5: Objective Multi-Tier Verification&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; margin-top: 6px; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color: #555;&quot;&gt;THEORY:&lt;/b&gt; Never trust the agent&#39;s self-reported success. Verification must be external, objective, and multi-layered (behavioral + structural AST).&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #c62828;&quot;&gt;OUR LAB 2 IMPLEMENTATION:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;background: #ffebee; color: #b71c1c;&quot;&gt;harness/verifier.py&lt;/code&gt; &amp;rarr; &lt;b&gt;verify_changes()&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Tier 1 (Behavior):&lt;/b&gt; Runs &lt;code&gt;pytest -v&lt;/code&gt; subprocess &amp;amp; checks exit code 0&lt;br/&gt;• &lt;b&gt;Tier 2 (Code Guard):&lt;/b&gt; Inspects AST/text for &lt;code&gt;if b == 0&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Tier 3 (Test Guard):&lt;/b&gt; Verifies addition of &lt;code&gt;test_divide_by_zero&lt;/code&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef9a9a;strokeWidth=1.5;arcSize=8;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="sec2_container">
          <mxGeometry x="455" y="240" width="410" height="175" as="geometry" />
        </mxCell>

        <!-- CARD 6: Closed-Loop Retry & Telemetry -->
        <mxCell id="card6" value="&lt;b style=&quot;font-size: 13px; color: #263238;&quot;&gt;Principle 6: Closed-Loop Self-Healing &amp;amp; Telemetry&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align: left; font-size: 11px; margin-top: 6px; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color: #555;&quot;&gt;THEORY:&lt;/b&gt; When verification fails, the harness must not give up immediately, but must feed the compiler/test error back to the agent under strict retry budgets.&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #455a64;&quot;&gt;OUR LAB 2 IMPLEMENTATION:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;background: #eceff1; color: #263238;&quot;&gt;harness/orchestrator.py&lt;/code&gt; &amp;rarr; &lt;b&gt;Retry State Machine&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;max_retries = 2&lt;/code&gt; prevents infinite token loops&lt;br/&gt;&lt;code style=&quot;background: #eceff1; color: #263238;&quot;&gt;harness/logger.py&lt;/code&gt; &amp;rarr; &lt;b&gt;HarnessLogger&lt;/b&gt;&lt;br/&gt;• Real-time &lt;code&gt;jsonl&lt;/code&gt; streaming for full auditability &amp;amp; replay debugging&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;strokeWidth=1.5;arcSize=8;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="sec2_container">
          <mxGeometry x="890" y="240" width="405" height="175" as="geometry" />
        </mxCell>

        <!-- SUMMARY COMPARISON TABLE -->
        <mxCell id="summary_table_title" value="&lt;b style=&quot;font-size: 13px; color: #1565c0;&quot;&gt;QUICK REFERENCE: OUR SIMULATION CODE VS. ENTERPRISE PRODUCTION HARNESS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#90caf9;strokeWidth=1;fontSize=12;fontColor=#0d47a1;arcSize=6;" vertex="1" parent="sec2_container">
          <mxGeometry x="25" y="435" width="1270" height="30" as="geometry" />
        </mxCell>

        <mxCell id="summary_grid" value="&lt;table style=&quot;width: 100%; border-collapse: collapse; font-size: 11px; text-align: left;&quot;&gt;&lt;tr style=&quot;background-color: #f5f5f5;&quot;&gt;&lt;th style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Harness Capability&lt;/th&gt;&lt;th style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Our Lab 2 Educational Simulation&lt;/th&gt;&lt;th style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Enterprise Production Harness (Antigravity / Swe-Bench / Devin)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;&lt;b&gt;Context Collection&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Recursive directory string concatenation (12k chars max)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Tree-sitter AST symbol graphs, vector embeddings, ctags indexing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;&lt;b&gt;Sandboxing&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;In-process path check &amp;amp; string pattern blocking (&lt;code&gt;rm -rf&lt;/code&gt;)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Docker / Firecracker microVMs, network egress filtering, seccomp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;&lt;b&gt;Verification&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;&lt;code&gt;pytest -v&lt;/code&gt; + text search for &lt;code&gt;if b == 0&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Full CI pipeline, static analysis (Mypy, Black, Sonar), mutation testing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;&lt;b&gt;Self-Correction&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Fixed retry counter (attempt 1..3) re-invoking executor&lt;/td&gt;&lt;td style=&quot;border: 1px solid #ddd; padding: 6px;&quot;&gt;Automated git commit revert, diff-based feedback, tree-search branching&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0e0e0;strokeWidth=1;arcSize=6;align=left;spacing=8;" vertex="1" parent="sec2_container">
          <mxGeometry x="25" y="470" width="1270" height="135" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
