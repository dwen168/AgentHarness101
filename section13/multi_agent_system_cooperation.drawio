        <mxCell id="c_q_test_to_rev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="sec1_container" source="gate_tester" target="gate_reviewer">
          <mxGeometry relative="1" as="geometry" />
