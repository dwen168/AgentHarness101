        </mxCell>

        <mxCell id="gate_sec_final" value="&lt;b&gt;5D. Final Security Gate&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;• Pre-Deployment Audit&lt;br/&gt;• Permission Blast-Radius&lt;br/&gt;• Compliance Sign-Off&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11;fontColor=#991b1b;arcSize=8;align=center;" vertex="1" parent="sec1_container">
          <mxGeometry x="805" y="415" width="235" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step7_release" value="&lt;b&gt;6. Verified Release&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #166534;&quot;&gt;• All Quality Gates Green&lt;br/&gt;• Clean Commit &amp;amp; Tag&lt;br/&gt;• Production Deployment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=11;fontColor=#15803d;arcSize=10;align=center;" vertex="1" parent="sec1_container">
