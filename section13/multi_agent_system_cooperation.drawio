          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Non-Overlapping Outer Feedback Loop: Tester -> Developer via Left Gutter -->
        <mxCell id="c_feedback" value="Defect Feedback Loop (Self-Healing)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;strokeDashArray=3 3;fontColor=#b91c1c;fontSize=10;" edge="1" parent="sec1_container" source="gate_tester" target="agent_dev">
