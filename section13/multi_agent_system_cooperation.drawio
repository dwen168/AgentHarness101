          </mxGeometry>
        </mxCell>

        <!-- Downward Connectors from Parallel Agents to Merge Engine (Straight Down, Zero Overlap) -->
        <mxCell id="c_m_dev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;" edge="1" parent="sec1_container" source="agent_dev" target="step4_merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_m_res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;" edge="1" parent="sec1_container" source="agent_research" target="step4_merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
