          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_m_sec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;" edge="1" parent="sec1_container" source="agent_sec_parallel" target="step4_merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Merge Engine to Conflict Engine -->
        <mxCell id="c_merge_to_conflict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ca8a04;strokeWidth=2;" edge="1" parent="sec1_container" source="step4_merge" target="step5_conflict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Conflict Engine to Quality Pipeline -->
        <mxCell id="c_conflict_to_tester" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;" edge="1" parent="sec1_container" source="step5_conflict" target="gate_tester">
